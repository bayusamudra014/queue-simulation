# Read automatically by `docker compose`. Override per run, e.g.
#   WORKER_REPLICAS=3 docker compose --profile queue up --build

# Service B (sync and queue) is the only part with a concurrency limit:
# number of worker containers, and reports each one runs at once.
# Total capacity = WORKER_REPLICAS x WORKER_CONCURRENCY. In sync mode, requests beyond that get 503.
WORKER_REPLICAS=2
WORKER_CONCURRENCY=2

# DB query delay for every report (ms), whatever its size
REPORT_MS=1000

# Report size: time to build one row (ms), and rows used when a request sends none.
# Total time per report = REPORT_MS + rows * ROW_MS
ROW_MS=1
DEFAULT_REPORT_ROWS=1000

# Chance (0..1) that one attempt succeeds; the rest fail with a simulated DB error.
# Sync: a failure returns 500 and the report is lost. Queue: see DLQ below.
SUCCESS_RATE=1

# Queue only. Dead-letter queue, off by default.
# Off: each job gets 1 attempt; a failure is final (job stays in "failed").
# On: each job gets JOB_ATTEMPTS tries (exponential backoff 2 s, 4 s, ...), and a job that
#     fails all of them is moved to the "reports-dlq" queue (GET /dlq, POST /dlq/:id/retry).
DLQ_ENABLED=false
JOB_ATTEMPTS=3
